# RAWG API key (https://rawg.io/apidocs). Used only by the backend, never shipped to the browser.
RAWG_API_KEY=your_rawg_api_key_here

# JWT signing secret, at least 32 characters: openssl rand -hex 32
JWT_SECRET=change_me_to_a_random_string_of_32_chars_min

# Database: either DATABASE_URL or the discrete DB_* vars (used by native `go run .`).
DATABASE_URL=
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=games_randomized
DB_SSL=false
# Optional PEM CA. With DigitalOcean Managed PostgreSQL it enables full certificate verification.
DB_SSL_CA=

# Comma-separated CORS origins (dev server runs on 4200).
FRONTEND_URL=http://localhost:4200
PORT=8000

# Optional OpenAI-compatible gateway for AI explanations (feature disabled when empty).
AI_GATEWAY_URL=
AI_GATEWAY_KEY=
AI_MODEL=gpt-4o-mini
