server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/plain text/css application/json application/javascript image/svg+xml;

    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: https://media.rawg.io https://steamcdn-a.akamaihd.net https://*.steamstatic.com; media-src 'self' https://media.rawg.io https://steamcdn-a.akamaihd.net https://*.steamstatic.com; font-src 'self' https://fonts.gstatic.com; connect-src 'self'; frame-ancestors 'self'; base-uri 'self'; form-action 'self'" always;

    client_max_body_size 1m;

    location / {
        try_files $uri $uri/ /index.html;
    }

    # BACKEND_UPSTREAM is substituted by the nginx image entrypoint (envsubst).
    location /api/ {
        proxy_pass http://${BACKEND_UPSTREAM}/api/;
        proxy_set_header Host $host;
        # Client address for rate limiting. CLIENT_IP is "$remote_addr" by default; only behind
        # DigitalOcean's edge (.do/app.yaml) is it "$http_do_connecting_ip", a header the edge sets.
        # Never trust a request header without a proxy in front that owns it.
        proxy_set_header X-Real-IP ${CLIENT_IP};
        proxy_set_header X-Forwarded-For "";
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff2?)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        # add_header in a location drops the server-level ones; re-send the essentials.
        add_header X-Content-Type-Options "nosniff" always;
    }
}
